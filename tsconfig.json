{
  // Type-checks the Node side: unit tests, the engine-less e2e suite and scripts.
  // The plugin itself is checked by plugin/tsconfig.json.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "allowJs": false
  },
  "include": ["unit", "e2e"]
}
